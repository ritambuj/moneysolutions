# Copy to `.env.local` for local dev.

# --- Local (either works if your Supabase project is active) ---
# Direct (Session mode):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Pooler (recommended for serverless-style local testing):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

PAYLOAD_SECRET=your-long-random-secret

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Vercel Production (required settings) ---
# Use the *Transaction* pooler URI from Supabase (NOT the direct db.*.supabase.co host unless you know you need it).
# Supabase → Project Settings → Database → Connection string → URI → "Transaction" mode
#
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# PAYLOAD_SECRET=same-long-secret-as-local-or-new-for-prod
# NEXT_PUBLIC_SERVER_URL=https://www.moneystar.co.in
#
# If the password contains @ # % & etc., URL-encode it in the connection string.
# After changing env vars on Vercel: redeploy. Run migrations once against prod DB: npm run db:migrate

# One-time / after schema changes: npm run db:migrate (see DEV.md)
